{
  "name": "@yannelli/callrail",
  "version": "0.1.1",
  "description": "TypeScript SDK for the CallRail API v3. A typed Node.js client with automatic pagination, safe retries, webhook signature checks, and test helpers.",
  "keywords": [
    "callrail",
    "callrail-api",
    "callrail-sdk",
    "call-tracking",
    "sdk",
    "api-client",
    "typescript",
    "nodejs",
    "webhooks",
    "sms",
    "lead-tracking",
    "marketing-attribution"
  ],
  "homepage": "https://github.com/yannelli/callrail-sdk-typescript#readme",
  "bugs": {
    "url": "https://github.com/yannelli/callrail-sdk-typescript/issues"
  },
  "license": "MIT",
  "author": "Ryan Yannelli (https://ryanyannelli.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yannelli/callrail-sdk-typescript.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./webhooks": "./dist/webhooks.js",
    "./testing": "./dist/testing.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "artwork": "tsc -p tsconfig.test.json && node .test-dist/scripts/generate-artwork.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "docs:check": "tsc -p tsconfig.test.json && node .test-dist/scripts/check-docs.js && tsc -p tsconfig.docs.json",
    "check": "npm run typecheck && npm test && npm run build && npm run docs:check",
    "release": "tsc -p tsconfig.test.json && node .test-dist/scripts/release.js",
    "release:dry-run": "npm run release -- --dry-run"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/node": "^20",
    "typescript": "^5.5"
  }
}
